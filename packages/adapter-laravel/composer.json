{
  "name": "kylat/laravel",
  "description": "Laravel adapter for Kylat frontend toolchain",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/cache": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Kylat\\": "src/",
      "Kylat\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kylat\\Laravel\\KylatServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": [
      "php -d zend.assertions=1 -d assert.exception=1 test/AdapterTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/CacheDriverIdempotencyTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/ReadEndpointTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/RateLimitTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/ConformanceTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/DatabaseIdempotencyTest.php",
      "php -d zend.assertions=1 -d assert.exception=1 test/ConcurrencyIdempotencyTest.php"
    ]
  }
}
